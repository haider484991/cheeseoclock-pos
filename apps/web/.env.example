# Neon Postgres connection string (Vercel → Project → Settings → Environment Variables)
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/cheeseoclock?sslmode=require"

# Shared secret between the POS bridge and the website API.
# Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Paste the same value into POS → Settings → Website.
BRIDGE_SECRET="change-me"
